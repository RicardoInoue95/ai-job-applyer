# Copie para .env e preencha. O .env NUNCA é versionado (ver .gitignore).
#
#   cp .env.example .env
#
# Variáveis de ambiente têm precedência sobre data/config.json. Depois de
# preencher aqui, remova os segredos correspondentes do config.json.

# ── Provedor de IA ───────────────────────────────────────────────────────────
# Preencha a chave de PELO MENOS UM. Se AIJOB_LLM_PROVEDOR ficar vazio, o
# projeto autodetecta: usa o primeiro com chave, na ordem openai → gemini →
# anthropic. Trocar de provedor é só preencher outra chave.
#
# openai | gemini | anthropic
AIJOB_LLM_PROVEDOR=
# Vazio usa o padrão do provedor (openai: gpt-5.6-luna, gemini: gemini-2.5-flash,
# anthropic: claude-sonnet-5). Ver MODELOS_SUGERIDOS em agents/llm/providers.py.
AIJOB_LLM_MODELO=

# https://platform.openai.com/api-keys
AIJOB_OPENAI_API_KEY=
# https://aistudio.google.com/apikey
AIJOB_GEMINI_API_KEY=
# https://console.anthropic.com/settings/keys
AIJOB_ANTHROPIC_API_KEY=

# ── Banco ────────────────────────────────────────────────────────────────────
AIJOB_DATABASE_URL=postgresql://jobapplier:jobapplier@localhost:5432/jobapplier

# ── E-mail (relatório diário) ────────────────────────────────────────────────
# Gmail exige senha de app, não a senha da conta:
# https://myaccount.google.com/apppasswords
AIJOB_SMTP_USER=
AIJOB_SMTP_PASS=
